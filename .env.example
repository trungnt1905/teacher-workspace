# Local development defaults. Production values: see docs/DETAIL_DESIGN.md §13.6.
# Never commit a real .env.

APP_NAME="Teacher Workspace"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Ho_Chi_Minh

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MVP has no database (DETAIL_DESIGN §6.5). Nothing should open a DB connection.
DB_CONNECTION=sqlite

# Single pre-provisioned account (DETAIL_DESIGN §12.1) — wired up in Phase 3.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Session lives in an encrypted cookie so it survives container restarts.
SESSION_DRIVER=cookie
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=array

MAIL_MAILER=log

# Timetable sync (DETAIL_DESIGN §13.3). Paths default to backend/python and storage/app/private.
# Empty = use python/.venv if present, else python3. Docker sets an absolute path.
PYTHON_BINARY=
TIMETABLE_MAX_FILE_SIZE_MB=5
TIMETABLE_JOB_TTL_MINUTES=60
TIMETABLE_MAX_JOBS=5
TIMETABLE_PROCESS_TIMEOUT=60
