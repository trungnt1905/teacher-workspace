# Rendered by entrypoint.sh with envsubst (only ${PORT} is substituted).
server {
    listen ${PORT} default_server;
    server_name _;
    root /var/www/app/public;
    index index.php;

    # 2 files × 5MB + multipart overhead (DETAIL_DESIGN §13.3)
    client_max_body_size 12M;
    server_tokens off;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy same-origin always;

    # Hashed Vite assets: cache for a long time
    location /build/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
        try_files $uri =404;
    }

    location / {
        try_files $uri /index.php?$query_string;
    }

    location = /index.php {
        fastcgi_pass 127.0.0.1:9000;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        include fastcgi_params;
        # Debian's fastcgi_params sends $host (no port): asset URLs would lose a non-standard port
        # when the container is run locally (e.g. -p 8090:10000). On Render, X-Forwarded-Host is used.
        fastcgi_param HTTP_HOST $http_host;
        fastcgi_read_timeout 90s;
        fastcgi_buffers 16 16k;
        fastcgi_buffer_size 32k;
    }

    # Never serve other PHP files or dotfiles directly
    location ~ \.php$ { return 404; }
    location ~ /\. { deny all; }
}
