{
  "profile_id": "lbg-tieu-hoc-v2",
  "template_sheet": "MẪU",
  "week_sheet_pattern": "^TU[ẦA]N\\s*0*(\\d{1,2})$",
  "header_row": 3,
  "cells": {
    "week_title": "A1",
    "sign_date": "E36"
  },
  "structure_anchors": [
    { "cell": "A3", "value": "Thứ" },
    { "cell": "B3", "value": "Buổi" },
    { "cell": "C3", "value": "Tiết" },
    { "cell": "D3", "value": "Môn" },
    { "cell": "E3", "value": "Tên bài" }
  ],
  "days": [
    { "label": "Hai", "date_cell": "A4",  "sessions": { "SÁNG": [4, 7],   "CHIỀU": [8, 10] } },
    { "label": "Ba",  "date_cell": "A11", "sessions": { "SÁNG": [11, 14], "CHIỀU": [15, 17] } },
    { "label": "Tư",  "date_cell": "A18", "sessions": { "SÁNG": [18, 21], "CHIỀU": [22, 23] } },
    { "label": "Năm", "date_cell": "A24", "sessions": { "SÁNG": [24, 27], "CHIỀU": [28, 29] } },
    { "label": "Sáu", "date_cell": "A30", "sessions": { "SÁNG": [30, 33], "CHIỀU": [34, 35] } }
  ],
  "columns": {
    "day": "A",
    "session": "B",
    "period": "C",
    "subject": "D",
    "lesson": "E",
    "equipment": "F"
  }
}
